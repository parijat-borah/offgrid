# API settings. `npm run dev` copies this to apps/api/.env with fresh random secrets on first run.
# Never commit a real .env.

PORT=4000
NODE_ENV=development
DATABASE_FILE=./offgrid.db
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# HMAC key for 15-minute access tokens (base64, 48+ random bytes). Refresh tokens are random and stored hashed.
JWT_ACCESS_SECRET=
REFRESH_TOKEN_TTL_DAYS=30

# --- PII encryption (AES-256-GCM): 32 random bytes, base64 ---
PII_ENCRYPTION_KEY=

# --- Uploads (photos are re-encoded to WebP with all metadata stripped) ---
UPLOAD_DIR=./uploads

# --- Adapters: mock | real (used from Phase 4/5) ---
OTP_MODE=mock
KYC_MODE=mock
LIVENESS_MODE=mock
WEATHER_MODE=openmeteo
# SOS texts to emergency contacts. mock = recorded and shown in the app, never sent (refused in production).
SMS_MODE=mock
# Where the web app is served, for the live-status link in SOS messages.
PUBLIC_WEB_URL=http://localhost:5173

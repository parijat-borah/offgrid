{
  "name": "@offgrid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/init-env.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "set-role": "tsx src/scripts/set-role.ts",
    "predemo:seed": "node ../../scripts/init-env.mjs",
